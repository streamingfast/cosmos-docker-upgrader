# Instance configuration for cosmos-docker-upgrader@<instance>.service
#
# Copy to /etc/cosmos-docker-upgrader/<instance>.env, then:
#
#   systemctl enable --now cosmos-docker-upgrader@<instance>
#
# For example, /etc/cosmos-docker-upgrader/injective-evm-testnet.env drives
# cosmos-docker-upgrader@injective-evm-testnet.service.

# Directory holding docker-compose.yml and docker-compose.yml-next
CHAIN_FOLDER=/data/injective-evm-testnet

# Directory the chain writes upgrade-info.json into
DATA_FOLDER=/data/injective-evm-testnet/node/data

# Where the rotated log is written
LOG_FILE=/data/injective-evm-testnet/upgrader.log

# Rotation, passed to rotatelogs
LOG_ROTATE_COUNT=5
LOG_ROTATE_SIZE=1M

# Extra flags, word split when passed to the binary. Quote them so the file can
# also be sourced by a shell, systemd strips the quotes. For example:
#   EXTRA_FLAGS="--status-interval=30m --poll-interval=15s"
EXTRA_FLAGS=""

# Uncomment for verbose file event logging
#DLOG=upgrader=debug

# Log format, console (default, human readable) or json
#LOG_FORMAT=console
